{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
       {
           "name": "Run CSharpier",
           "group": "format",
           "command": "dotnet",
           "args": ["tool", "run", "csharpier", "format", "${staged}"],
           "include": [
               "**/*.cs",
               "**/*.csproj",
               "**/*.props",
               "**/*.targets"
           ],
		   "exclude": [
			   "ThunderPipe.Sdk/**/*"
		   ]
	   }
   ]
}
